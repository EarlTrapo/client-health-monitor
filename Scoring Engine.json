    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\n\n// ── Weights ──────────────────────────────────────────────\nconst WEIGHTS = {\n  financial:    0.25,\n  communication: 0.20,\n  engagement:   0.20,\n  sentiment:    0.20,\n  behavioral:   0.15\n};\n\n// ── Signal → category + scoring function ─────────────────\nconst SIGNAL_MAP = {\n  invoice_overdue_days: {\n    category: 'financial',\n    score: v => v <= 0 ? 100 : v <= 5 ? 70 : v <= 14 ? 40 : 10\n  },\n  email_response_time_hours: {\n    category: 'communication',\n    score: v => v === null ? 50 : v <= 4 ? 100 : v <= 24 ? 70 : v <= 48 ? 40 : 10\n  },\n  days_since_last_meeting: {\n    category: 'engagement',\n    score: v => v === null ? 50 : v <= 7 ? 100 : v <= 14 ? 70 : v <= 21 ? 40 : 10\n  },\n  support_ticket_volume: {\n    category: 'behavioral',\n    score: v => v === null ? 50 : v <= 2 ? 100 : v <= 5 ? 70 : v <= 8 ? 40 : 10\n  }\n};\n\n// ── Group rows by client ──────────────────────────────────\nconst clients = {};\nfor (const row of rows) {\n  const id = row.client_id;\n  if (!id) continue;\n  if (!clients[id]) {\n    clients[id] = { client_id: id, client_name: row.client_name, signals: {} };\n  }\n  // Keep latest signal per signal_name\n  if (SIGNAL_MAP[row.signal_name]) {\n    clients[id].signals[row.signal_name] = parseFloat(row.signal_value);\n  }\n}\n\n// ── Score each client ─────────────────────────────────────\nconst today = new Date().toISOString().slice(0, 10);\nconst results = [];\n\nfor (const client of Object.values(clients)) {\n  const scores = {};\n  const missing = [];\n\n  for (const [signal, config] of Object.entries(SIGNAL_MAP)) {\n    const val = client.signals[signal] ?? null;\n    if (val === null || isNaN(val)) {\n      scores[config.category] = scores[config.category] ?? 50;\n      missing.push(signal);\n    } else {\n      scores[config.category] = config.score(val);\n    }\n  }\n\n  // Sentiment defaults to 50 (no connector yet)\n  scores.sentiment = scores.sentiment ?? 50;\n\n  const total = Math.round(\n    (scores.financial    * WEIGHTS.financial) +\n    (scores.communication * WEIGHTS.communication) +\n    (scores.engagement   * WEIGHTS.engagement) +\n    (scores.sentiment    * WEIGHTS.sentiment) +\n    (scores.behavioral   * WEIGHTS.behavioral)\n  );\n\n  const rag = total >= 70 ? '🟢 Green' : total >= 40 ? '🟡 Amber' : '🔴 Red';\n\n  // Find worst signal\n  const worstSignal = Object.entries(scores)\n    .filter(([k]) => k !== 'sentiment')\n    .sort((a, b) => a[1] - b[1])[0][0];\n\n  results.push({\n    json: {\n      date: today,\n      client_id: client.client_id,\n      client_name: client.client_name,\n      comm_score:        scores.communication,\n      financial_score:   scores.financial,\n      engagement_score:  scores.engagement,\n      sentiment_score:   scores.sentiment,\n      behavioral_score:  scores.behavioral,\n      total_score:       total,\n      rag_status:        rag,\n      trend:             '→',\n      top_risk_signal:   worstSignal,\n      missing_data_flags: missing.join(', ') || '—'\n    }\n  });\n}\n\nreturn results;"
      },
