    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\n\n// Get most recent score per client\nconst latest = {};\nfor (const row of rows) {\n  if (!row.client_id) continue;\n  if (!latest[row.client_id] || row.date > latest[row.client_id].date) {\n    latest[row.client_id] = row;\n  }\n}\n\nconst clients = Object.values(latest);\nconst green = clients.filter(c => c.rag_status?.includes('Green'));\nconst amber = clients.filter(c => c.rag_status?.includes('Amber'));\nconst red   = clients.filter(c => c.rag_status?.includes('Red'));\n\nconst formatClient = c =>\n  `• ${c.client_name} — ${c.total_score}/100 ${c.rag_status} | Risk: ${c.top_risk_signal}`;\n\nconst lines = [\n  `📊 *Weekly Client Health Report*`,\n  `${new Date().toDateString()}`,\n  ``,\n  `🟢 Healthy (${green.length})`,\n  ...green.map(formatClient),\n  ``,\n  `🟡 Watch (${amber.length})`,\n  ...amber.map(formatClient),\n  ``,\n  `🔴 At Risk (${red.length})`,\n  ...red.map(formatClient),\n  ``,\n  `Total clients monitored: ${clients.length}`\n];\n\nreturn [{ json: { message: lines.join('\\n') } }];\n"
      },
