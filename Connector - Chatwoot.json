    {
      "parameters": {
        "jsCode": "const clientMap = $input.all().map(i => i.json);\n\n// Mock ticket volumes matching our three RAG bands\nconst mockTickets = {\n  'CLT_001': 1,  // Nexus Protocol — healthy, low tickets\n  'CLT_002': 4,  // DeltaFi Labs — watch, moderate tickets\n  'CLT_003': 9,  // Cipher Ventures — at risk, high tickets\n};\n\nconst results = clientMap.map(client => ({\n  json: {\n    timestamp: new Date().toISOString().replace(\"T\", \" \").slice(0, 19),\n    client_id: client.client_id,\n    client_name: client.client_name,\n    signal_name: \"support_ticket_volume\",\n    signal_value: mockTickets[client.client_id] ?? null,\n    signal_category: \"Behavioral\",\n    data_source: \"Chatwoot\"\n  }\n}));\n\nreturn results;"
      },
