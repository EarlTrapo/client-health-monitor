    {
      "parameters": {
        "jsCode": "const messages = $input.all();\nconst clientMap = $('Read Client Map').all().map(i => i.json);\n\nconst results = [];\nconst now = Date.now();\n\nfor (const msg of messages) {\n  const headers = msg.json.headers || {};\n  \n  // Strip \"From: \" prefix and extract email\n  const fromRaw = headers['from'] || \"\";\n  const emailMatch = fromRaw.match(/<(.+?)>/) || fromRaw.match(/[\\w.-]+@[\\w.-]+/);\n  const email = emailMatch ? emailMatch[1] || emailMatch[0] : null;\n  const domainMatch = email ? email.match(/@([\\w.-]+)/) : null;\n  const domain = domainMatch ? domainMatch[1].toLowerCase() : null;\n  if (!domain) continue;\n\n  // Match to client\n  const client = clientMap.find(c =>\n    domain.includes(c.email_domain.toLowerCase())\n  );\n  if (!client) continue;\n\n  // Strip \"Date: \" prefix and parse\n  const dateRaw = headers['date'] || \"\";\n  const dateClean = dateRaw.replace(/^Date:\\s*/i, \"\");\n  const msgTime = new Date(dateClean).getTime();\n  const hoursAgo = (now - msgTime) / (1000 * 60 * 60);\n\n  results.push({\n    json: {\n      timestamp: new Date().toISOString().replace(\"T\", \" \").slice(0, 19),\n      client_id: client.client_id,\n      client_name: client.client_name,\n      signal_name: \"email_response_time_hours\",\n      signal_value: parseFloat(hoursAgo.toFixed(1)),\n      signal_category: \"Communication\",\n      data_source: \"Gmail\"\n    }\n  });\n}\n\n// Missing data rows for clients with no emails\nfor (const client of clientMap) {\n  const found = results.find(r => r.json.client_id === client.client_id);\n  if (!found) {\n    results.push({\n      json: {\n        timestamp: new Date().toISOString().replace(\"T\", \" \").slice(0, 19),\n        client_id: client.client_id,\n        client_name: client.client_name,\n        signal_name: \"email_response_time_hours\",\n        signal_value: null,\n        signal_category: \"Communication\",\n        data_source: \"Gmail\"\n      }\n    });\n  }\n}\n\nreturn results;"
      },
