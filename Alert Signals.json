    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\n\n// Get today's scores only\nconst today = new Date().toISOString().slice(0, 10);\nconst todayRows = rows.filter(r => r.date === today);\n\nconst alerts = [];\n\nfor (const row of todayRows) {\n  const score = parseFloat(row.total_score);\n  const rag = row.rag_status;\n\n  // Only alert on Amber and Red\n  if (rag.includes('Green')) continue;\n\n  const urgency = rag.includes('Red') ? '🔴 CRITICAL' : '🟡 WATCH';\n  const action = rag.includes('Red')\n    ? 'Immediate outreach required. Prepare save plan.'\n    : 'Schedule a check-in call this week.';\n\n  alerts.push({\n    json: {\n      client_name:      row.client_name,\n      total_score:      score,\n      rag_status:       rag,\n      top_risk_signal:  row.top_risk_signal,\n      urgency:          urgency,\n      action:           action,\n      message: `${urgency}\\n\\nClient: ${row.client_name}\\nScore: ${score}/100 ${rag}\\nTop Risk: ${row.top_risk_signal}\\n\\n${action}`\n    }\n  });\n}\n\n// If no alerts, return a clean all-clear\nif (alerts.length === 0) {\n  return [{\n    json: { message: '✅ All clients healthy. No action required today.' }\n  }];\n}\n\nreturn alerts;\n"
      },
