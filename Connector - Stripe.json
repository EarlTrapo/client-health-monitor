    {
      "parameters": {
        "jsCode": "const invoices = $input.first().json.data;\nconst clientMap = $('Get Client Info').all().map(i => i.json);\n\nconst results = [];\nconst now = Date.now() / 1000; // Stripe uses unix seconds\n\n// Filter out voided invoices, keep latest per customer email\nconst validInvoices = invoices.filter(inv => inv.status !== 'void');\n\nfor (const inv of validInvoices) {\n  const email = inv.customer_email || \"\";\n  const domainMatch = email.match(/@([\\w.-]+)/);\n  const domain = domainMatch ? domainMatch[1].toLowerCase() : null;\n  if (!domain) continue;\n\n  const client = clientMap.find(c =>\n    domain.includes(c.email_domain.toLowerCase())\n  );\n  if (!client) continue;\n\n  // Calculate days overdue\n  let signalValue = 0;\n  if (inv.status === 'open' && inv.due_date) {\n    const daysOverdue = (now - inv.due_date) / 86400;\n    signalValue = parseFloat(daysOverdue.toFixed(1));\n  } else if (inv.status === 'paid') {\n    const paidAt = inv.status_transitions?.paid_at;\n    const dueDate = inv.due_date;\n    if (paidAt && dueDate) {\n      const daysLate = (paidAt - dueDate) / 86400;\n      signalValue = daysLate > 0 ? parseFloat(daysLate.toFixed(1)) : 0;\n    }\n  }\n\n  results.push({\n    json: {\n      timestamp: new Date().toISOString().replace(\"T\", \" \").slice(0, 19),\n      client_id: client.client_id,\n      client_name: client.client_name,\n      signal_name: \"invoice_overdue_days\",\n      signal_value: signalValue,\n      signal_category: \"Financial\",\n      data_source: \"Stripe\"\n    }\n  });\n}\n\n// Missing data rows for clients with no invoices\nfor (const client of clientMap) {\n  const found = results.find(r => r.json.client_id === client.client_id);\n  if (!found) {\n    results.push({\n      json: {\n        timestamp: new Date().toISOString().replace(\"T\", \" \").slice(0, 19),\n        client_id: client.client_id,\n        client_name: client.client_name,\n        signal_name: \"invoice_overdue_days\",\n        signal_value: null,\n        signal_category: \"Financial\",\n        data_source: \"Stripe\"\n      }\n    });\n  }\n}\n\nreturn results;"
      },
