    {
      "parameters": {
        "jsCode": "const clientMap = $input.all().map(i => i.json);\n\n// Mock days since last meeting per client\nconst mockMeetings = {\n  'CLT_001': 7,   // Nexus Protocol — healthy, met last week\n  'CLT_002': 18,  // DeltaFi Labs — watch, meeting cadence slipping\n  'CLT_003': 28,  // Cipher Ventures — at risk, no meeting in 4 weeks\n};\n\nconst results = clientMap.map(client => ({\n  json: {\n    timestamp: new Date().toISOString().replace(\"T\", \" \").slice(0, 19),\n    client_id: client.client_id,\n    client_name: client.client_name,\n    signal_name: \"days_since_last_meeting\",\n    signal_value: mockMeetings[client.client_id] ?? null,\n    signal_category: \"Engagement\",\n    data_source: \"Google Calendar\"\n  }\n}));\n\nreturn results;"
      },
